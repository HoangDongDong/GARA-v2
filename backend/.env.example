PORT=4000

FB_HOST=127.0.0.1
FB_PORT=3050
FB_DATABASE=./GARAGE.FDB
FB_USER=SYSDBA
FB_PASSWORD=masterkey
# Đổi thành một chuỗi bí mật riêng khi triển khai nhiều máy.
AUTH_TOKEN_SECRET=change-this-secret-in-production

# Google AI Studio / Gemini multimodal vehicle recognition.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Optional override; default uses the watermark-free FastReport Open Source renderer.
# FASTREPORT_RENDERER_EXE=<absolute path to Garage.FastReportRenderer.exe>
